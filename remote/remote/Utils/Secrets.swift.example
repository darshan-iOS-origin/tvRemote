// Copy this file to Secrets.swift (same folder) and put the real values in. Secrets.swift is in .gitignore
// and is never committed. This .example file is not compiled.

import Foundation

enum Secrets {

    /// RevenueCat public Apple SDK key (starts with "appl_").
    static let revenueCatAPIKey = "PASTE_REVENUECAT_APPLE_SDK_KEY"

    /// OneSignal App ID (Dashboard > Settings > Keys & IDs).
    static let oneSignalAppID = "PASTE_ONESIGNAL_APP_ID"

    /// Facebook App ID and client token. The App ID is also in Info.plist as the URL scheme fb<appID>.
    static let facebookAppID = "PASTE_FACEBOOK_APP_ID"
    static let facebookClientToken = "PASTE_FACEBOOK_CLIENT_TOKEN"

    /// Microsoft Clarity project ID.
    static let clarityProjectID = "PASTE_CLARITY_PROJECT_ID"
}

// Copy this file to Secrets.xcconfig (same folder) and put your real key there. Secrets.xcconfig is in
// .gitignore and never committed.
//
// Use the PUBLIC Apple SDK key (starts with "appl_"), not a secret key, and not a Test Store key in a
// build you send to the App Store.

REVENUECAT_API_KEY = appl_PASTE_YOUR_PUBLIC_KEY_HERE

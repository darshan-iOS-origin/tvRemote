// Build settings shared by every configuration of the "remote" app target.
//
// REVENUECAT_API_KEY is read by the app from Info.plist (key "RevenueCatAPIKey"). Set it in
// Secrets.xcconfig, which is not in git. Copy Secrets.example.xcconfig to Secrets.xcconfig and paste your
// public Apple SDK key (RevenueCat > Project settings > API keys). Without it the app runs with purchases off.

REVENUECAT_API_KEY =

// "#include?" does not fail the build when the file is missing.
#include? "Secrets.xcconfig"
